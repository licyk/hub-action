{
  "$comment": [
    "仓库镜像同步配置, 由 scripts/git_mirror.py 读取",
    "repos 每一项支持三种写法:",
    "  \"foo\"      两边同名",
    "  \"foo:bar\"  源仓库 foo 同步到目的仓库 bar",
    "  {\"src\": \"foo\", \"dst\": \"bar\", \"rename\": {\"gitee\": \"baz\"}, \"destinations\": [\"gitee\"], \"enabled\": false}",
    "enabled 为 false 的仓库平时不同步, 但配置里保留着, 需要时用 --repo 指名或 --include-disabled 捞回来",
    "destinations 用来限定这个仓库只同步到哪些平台, 不写就是所有平台"
  ],
  "source": {
    "url": "git@github.com:licyk/{name}.git",
    "key_env": "SOURCE_SSH_PRIVATE_KEY"
  },
  "destinations": {
    "gitee": {
      "url": "git@gitee.com:licyk/{name}.git",
      "key_env": "GITEE_RSA_PRIVATE_KEY",
      "enabled": true
    },
    "gitlab": {
      "url": "git@gitlab.com:licyk/{name}.git",
      "key_env": "GITLAB_RSA_PRIVATE_KEY",
      "enabled": true
    },
    "bitbucket": {
      "url": "git@bitbucket.org:licyk/{name}.git",
      "key_env": "BITBUCKET_RSA_PRIVATE_KEY",
      "enabled": false
    }
  },
  "repos": [
    "term-sd",
    {
      "src": "t",
      "rename": {
        "gitee": "tt"
      }
    },
    "hub-action",
    "cursors-archive",
    "psh2bat",
    "ani2xcur-tui",
    "repo_mirror_tools",
    "ani2xcur",
    "sd-webui-all-in-one",
    "SDNote",
    "stablediffusion",
    "README-collection",
    "a1111-sd-webui-haku-img",
    "ssfconv",
    "sd-webui-wd14-tagger",
    "invoke_wd14_tagger",
    "ComfyUI-HakuImg",
    "sd-webui-licyk-style-image",
    "sd_forge_hypertile_svd_z123",
    "ComfyUI-TCD-Sampler",
    "action-gitee-release",
    "invoke_tipo",
    "licyk",
    "ComfyUI-Restart-Sampler",
    "PBRemTools",
    "advanced_euler_sampler_extension",
    "sd-webui-tcd-sampler",
    "scrcpy-tui",
    "cinnamon-theme-transparent",
    "bili-dl-merge",
    "qwen-tts-webui",
    "resources",
    "wheels",
    "sd-webui-all-in-one-launcher",
    "python-docstring-checker",
    "cursor-sheet",
    "aria2-bin",
    "aria2-next-bin"
  ]
}
